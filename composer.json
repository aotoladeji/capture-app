{
    "name": "id-card-platform/capture-backend",
    "type": "project",
    "description": "ID Card capture platform backend - converted from Node/Express to Laravel",
    "keywords": ["laravel", "id-card-platform"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "firebase/php-jwt": "^6.10",
        "phpoffice/phpspreadsheet": "^2.3",
        "ext-imagick": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/tinker": "^2.9",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/app/",
            "Database\\Factories\\": "backend/database/factories/",
            "Database\\Seeders\\": "backend/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "backend/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php backend/artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php backend/artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('backend/.env') || copy('backend/.env.example', 'backend/.env');\""
        ],
        "post-create-project-cmd": [
            "@php backend/artisan key:generate --ansi"
        ]
    },
    "config": {
        "vendor-dir": "backend/vendor",
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "ext-imagick": "3.7.0"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

