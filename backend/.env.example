APP_NAME="ID Card Capture Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:5001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

# ---------------------------------------------------------
# Database — IMPORTANT: this app shares its database with the
# "id-card-unit" management app (this app's searchUser() login flow
# reads the management app's `scheduled_students` table directly).
# Point this at the SAME MySQL database as that app's backend/.env,
# unless you've deliberately split them and set up cross-DB access.
# ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=id_card_unit
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------
# Auth
# ---------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string

# Used by /api/verify/fingerprint and /api/verify/fingerprint/templates/*
# (also required by the management app's CAPTURE_APP verification calls —
# must match VERIFY_API_KEY in that app's .env).
VERIFY_API_KEY=change_this_too

# ---------------------------------------------------------
# CORS - only needed if the frontend is served from a DIFFERENT origin
# than this backend (e.g. separate dev servers, or the frontend embedded
# in another site). When the frontend is built into backend/public (the
# merged single-app deployment), requests are same-origin and CORS does
# not apply.
# ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
CLIENT_URL=http://localhost:5001

# ---------------------------------------------------------
# Uploads
# ---------------------------------------------------------
MAX_FILE_SIZE=10485760

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
